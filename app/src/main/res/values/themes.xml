<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AICollab" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#06131F</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/success</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialButtonStyle">@style/Widget.AICollab.Button</item>
    </style>

    <style name="Widget.AICollab.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Text.* 的公共父样式，缺了它 aapt 会报 "resource style/Text not found" -->
    <style name="Text" />

    <style name="Text.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Section">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Body">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Mono">
        <item name="android:textColor">@color/mono_text</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
